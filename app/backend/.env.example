# Configuración de SYSTEMS: backend y Rëff integrado, que corren en el mismo proceso.
# Generado desde app/backend/config.js con npm run config:sync; no editar a mano.
#
# Uso: en desarrollo o sin Docker, copiar a app/backend/.env y rellenar. Con
# docker compose, copiar a .env en la raíz del repositorio
# (scripts/setup-env.sh lo hace y genera las claves).
# Producción: todo llega por variables de entorno (panel de Coolify, .env raíz
# de docker compose, ConfigMap y Secret de k8s). Con NODE_ENV=production el
# servidor no arranca si falta una obligatoria o tiene un formato inválido, y
# las lista todas a la vez; fuera de producción solo avisa.
# Solo en desarrollo server.js lee además Elvi-Ra/Mesas/Rëff/.env. Manda lo ya
# definido en el entorno, después este archivo y por último el de Rëff. En
# producción el .env de Rëff no se lee.
# Nunca poner valores reales en un archivo versionado.

# ── Servidor ────────────────────────────────────────────────────────────────
# NODE_ENV: Entorno de ejecución; production activa la validación estricta de
# esta lista. Opcional; por defecto, development.
# NODE_ENV=production
# PORT: Puerto HTTP del proceso. Opcional; por defecto, 5173.
# PORT=5173
# HOST: Interfaz de escucha. Opcional; por defecto, 0.0.0.0.
# HOST=0.0.0.0
# DATA_DIR: Carpeta del estado local (JSON ligeros, marca de arranque).
# Opcional; por defecto, app/backend/data. Para pruebas aisladas; en
# despliegue la ruta la fija el volumen de datos.
# DATA_DIR=
# CORS_ORIGIN: Orígenes cruzados permitidos, separados por comas. Opcional;
# por defecto, ninguno en producción (la interfaz se sirve desde el mismo
# dominio).
# CORS_ORIGIN=
# SHUTDOWN_GRACE_MS: Espera a peticiones en vuelo durante el apagado ordenado
# (ms). Opcional; por defecto, 10000 en k8s, 1500 fuera.
# SHUTDOWN_GRACE_MS=
# SHUTDOWN_HARD_MS: Tope duro del apagado ordenado (ms). Opcional; por
# defecto, 25000.
# SHUTDOWN_HARD_MS=

# ── Base de datos ───────────────────────────────────────────────────────────
# MONGO_URI: Cadena de conexión a MongoDB. Obligatoria en producción. Con
# docker compose se usa el servicio mongo; fuera de Docker, por ejemplo
# mongodb://127.0.0.1:27017/elvira.
MONGO_URI=

# ── Claves de firma y cifrado ───────────────────────────────────────────────
# JWT_SECRET: Firma de las sesiones de Rëff. Obligatoria en producción.
# Generar: openssl rand -hex 32.
JWT_SECRET=
# SENTINEL_FORENSIC_SECRET: Firma del registro forense de Sentinel,
# independiente de JWT_SECRET. Obligatoria en producción. Mínimo 32 bytes.
# Generar: openssl rand -hex 32 o, sin openssl, node -p
# "require('crypto').randomBytes(32).toString('hex')". Fuera de producción, si
# falta, se firma con una clave de desarrollo que producción rechaza.
# Cambiarla en un sistema con registro existente exige volver a sellarlo
# (Sentinel, Re-sellar cadena).
SENTINEL_FORENSIC_SECRET=
# FL_EXPEDIENTE_ENC_KEY: Cifrado del Expediente Fiscal y Jurídico. Obligatoria
# en producción. Generar: openssl rand -hex 32. Perderla deja ilegibles los
# documentos ya cifrados.
FL_EXPEDIENTE_ENC_KEY=

# ── Usuarios iniciales (solo primer arranque con la base vacía) ─────────────
# SEED_NOUR_PASSWORD: Contraseña inicial de Nour. Opcional.
SEED_NOUR_PASSWORD=
# SEED_MARC_PASSWORD: Contraseña inicial de Marc. Opcional.
SEED_MARC_PASSWORD=
# SEED_GONZALO_PASSWORD: Contraseña inicial de Gonzalo. Opcional.
SEED_GONZALO_PASSWORD=
# SEED_AMIR_PASSWORD: Contraseña inicial de Amir. Opcional.
SEED_AMIR_PASSWORD=
# SEED_RAY_PASSWORD: Contraseña inicial de Ray. Opcional.
SEED_RAY_PASSWORD=
# SEED_CELIA_PASSWORD: Contraseña inicial de Celia. Opcional.
SEED_CELIA_PASSWORD=
# SEED_MAITANE_PASSWORD: Contraseña inicial de Maitane. Opcional.
SEED_MAITANE_PASSWORD=
# SEED_ARKAITZ_PASSWORD: Contraseña inicial de Arkaitz. Opcional.
SEED_ARKAITZ_PASSWORD=
# SEED_OSCAR_PASSWORD: Contraseña inicial de Oscar. Opcional.
SEED_OSCAR_PASSWORD=
# REFF_SEED_MARC_PASSWORD: Contraseña inicial de Marc en Rëff. Opcional.
REFF_SEED_MARC_PASSWORD=
# REFF_SEED_NOUR_PASSWORD: Contraseña inicial de Nour en Rëff. Opcional.
REFF_SEED_NOUR_PASSWORD=
# REFF_SEED_AMIR_PASSWORD: Contraseña inicial de Amir en Rëff. Opcional.
REFF_SEED_AMIR_PASSWORD=
# REFF_SEED_GONZALO_PASSWORD: Contraseña inicial de Gonzalo en Rëff. Opcional.
REFF_SEED_GONZALO_PASSWORD=

# ── IA ──────────────────────────────────────────────────────────────────────
# LLM_PROVIDER: Proveedor de IA: ollama para el modelo local. Opcional; por
# defecto, el proveedor externo.
# LLM_PROVIDER=
# LLM_TIMEOUT_MS: Tiempo máximo de cada llamada a la IA (ms). Opcional; por
# defecto, 30000.
# LLM_TIMEOUT_MS=
# ANTHROPIC_API_KEY: Clave del proveedor de IA externo. Opcional. Sin ella,
# las funciones de IA del proveedor externo no responden.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL: Modelo del proveedor de IA externo. Opcional; por defecto,
# el definido en el código.
# ANTHROPIC_MODEL=
# OLLAMA_URL: URL del servidor Ollama. Opcional; por defecto,
# http://ollama:11434.
# OLLAMA_URL=
# OLLAMA_MODEL: Modelo de Ollama. Opcional; por defecto, llama3:70b.
# OLLAMA_MODEL=

# ── Fuentes de datos externas ───────────────────────────────────────────────
# ESIOS_API_KEY: Token personal de ESIOS (REE) para S-NFI U2. Opcional. Sin
# token, los datos públicos de REE siguen funcionando.
# ESIOS_API_KEY=
# GRID_AUTOSTART: Arranca los workers de Grid Interlink al iniciar (0 = no).
# Opcional; por defecto, 1.
# GRID_AUTOSTART=
# GRID_WORKER_MAX_OLD_MB: Techo de memoria de cada worker de Grid Interlink
# (MB). Opcional; por defecto, 96.
# GRID_WORKER_MAX_OLD_MB=
# GRID_ES_URL: Endpoint en vivo del operador de red de ES. Opcional; por
# defecto, modo simulado.
# GRID_ES_URL=
# GRID_PT_URL: Endpoint en vivo del operador de red de PT. Opcional; por
# defecto, modo simulado.
# GRID_PT_URL=
# GRID_FR_URL: Endpoint en vivo del operador de red de FR. Opcional; por
# defecto, modo simulado.
# GRID_FR_URL=
# GRID_MA_URL: Endpoint en vivo del operador de red de MA. Opcional; por
# defecto, modo simulado.
# GRID_MA_URL=

# ── Sentinel ────────────────────────────────────────────────────────────────
# SENTINEL_RISK_COUNTRIES: Países de riesgo elevado para el scoring (ISO-2,
# separados por comas). Opcional; por defecto, ninguno.
# SENTINEL_RISK_COUNTRIES=
# SENTINEL_EXTRA_SENSITIVE_PATHS: Prefijos de ruta extra con límite de
# peticiones estricto. Opcional; por defecto, ninguno.
# SENTINEL_EXTRA_SENSITIVE_PATHS=

# ── Systems y enlace Twin ───────────────────────────────────────────────────
# SYSTEMS_URL: URL del ØPHS real (puerto cerrado). Opcional; por defecto,
# simulación local.
# SYSTEMS_URL=
# SYSTEMS_TOKEN: Token Bearer para SYSTEMS_URL. Opcional.
# SYSTEMS_TOKEN=
# SYSTEMS_TIMEOUT_MS: Tiempo máximo de cada llamada a SYSTEMS_URL (ms).
# Opcional; por defecto, 15000.
# SYSTEMS_TIMEOUT_MS=
# ENABLE_TWIN_PORT: Activa el listener Twin en 127.0.0.1. Opcional; por
# defecto, false.
# ENABLE_TWIN_PORT=false
# TWIN_PORT: Puerto del listener Twin. Opcional; por defecto, 5174.
# TWIN_PORT=
# TWIN_TOKEN: Token del listener Twin. Obligatoria si ENABLE_TWIN_PORT=true.
# Generar: openssl rand -hex 32.
# TWIN_TOKEN=

# ── CIBE Bunker (tokens firmados de Pactvm Viridi) ──────────────────────────
# CIBE_MODE: off | auto (sesión de Admin con token automático trazado) |
# strict (cabecera X-CIBE-Token obligatoria). Opcional; por defecto, auto.
# CIBE_MODE=auto
# CIBE_TOKEN_TTL_S: Vida de cada token CIBE en segundos (de 30 a 3600).
# Opcional; por defecto, 120.
# CIBE_TOKEN_TTL_S=
# CIBE_PRIVATE_KEY_PEM: Clave privada Ed25519 (PEM). Obligatoria si se define
# CIBE_PUBLIC_KEY_PEM.
# CIBE_PRIVATE_KEY_PEM=
# CIBE_PUBLIC_KEY_PEM: Clave pública Ed25519 (PEM), pareja de la privada.
# Obligatoria si se define CIBE_PRIVATE_KEY_PEM.
# CIBE_PUBLIC_KEY_PEM=

# ── Rack State (consenso entre racks) ───────────────────────────────────────
# RACK_ID: Identificador de este rack. Opcional; por defecto, nombre de la
# máquina.
# RACK_ID=
# RACK_PEERS: URLs de los otros racks, separadas por comas. Opcional; por
# defecto, rack único (quórum 1).
# RACK_PEERS=
# RACK_SHARED_KEY: Firma de los mensajes entre racks. Obligatoria si se define
# RACK_PEERS. Generar: openssl rand -hex 32.
# RACK_SHARED_KEY=
# RACK_HEARTBEAT_MS: Latido del líder (ms). Opcional; por defecto, 500.
# RACK_HEARTBEAT_MS=
# RACK_ELECTION_MS_MIN: Espera mínima antes de convocar elección (ms).
# Opcional; por defecto, 1500.
# RACK_ELECTION_MS_MIN=

# ── Rëff: correo de reuniones y tareas programadas ──────────────────────────
# SMTP_HOST: Servidor SMTP de los avisos de reuniones. Opcional; por defecto,
# modo simulado (solo registro, no se envía nada).
# SMTP_HOST=
# SMTP_PORT: Puerto SMTP. Opcional; por defecto, 587.
# SMTP_PORT=
# SMTP_SECURE: TLS directo (true) o STARTTLS (false). Opcional; por defecto,
# false.
# SMTP_SECURE=
# SMTP_USER: Usuario SMTP. Opcional.
# SMTP_USER=
# SMTP_PASS: Contraseña SMTP. Opcional.
# SMTP_PASS=
# MAIL_FROM: Remitente de los avisos. Opcional; por defecto, SMTP_USER.
# MAIL_FROM=
# MEETING_REMINDER_CRON: Programación del recordatorio de reuniones (formato
# cron). Opcional; por defecto, cada 15 minutos.
# MEETING_REMINDER_CRON=
# WATCH_CRON_SCHEDULE: Programación de la vigilancia de empresas (formato
# cron). Opcional; por defecto, cada 6 horas.
# WATCH_CRON_SCHEDULE=

# ── Otras variables (no van en este archivo) ────────────────────────────────
# Las inyecta la plataforma: KUBERNETES_SERVICE_HOST (presente solo dentro de
# un pod de Kubernetes); HOSTNAME (nombre del pod o de la máquina).
# Solo herramientas: ENV_VAULT_KEY (clave de descifrado de
# scripts/env-vault.js; vive en el gestor de secretos de la plataforma);
# TEST_MONGO_DIR (carpeta con el binario y los datos del mongod de pruebas de
# scripts/test-mongo.js; por defecto ~/mongo-test); TEST_MONGOD_BIN (ruta del
# mongod que usa scripts/test-mongo.js si no está en TEST_MONGO_DIR).
# Obsoletas, el servidor avisa si aparecen: FOUNDRY_INGRESS_PORT (el pipeline
# de ingesta Lab está retirado); SERPAPI_KEY (ningún módulo la lee); DB_PATH
# (Rëff ya no usa almacenamiento en archivo; todo está en MongoDB);
# OLLAMA_BASE_URL (el nombre vigente es OLLAMA_URL); ESIOS_TOKEN (alias
# heredado; usar ESIOS_API_KEY).
